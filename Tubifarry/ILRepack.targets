<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Target Name="ILRepacker" AfterTargets="Build">
		<ItemGroup>
			<InputAssemblies Include="$(OutputPath)Lidarr.Plugin.$(MSBuildProjectName).dll" />
			<InputAssemblies Include="$(OutputPath)YouTubeMusicAPI.dll" />
			<InputAssemblies Include="$(OutputPath)YouTubeSessionGenerator.dll" />
			<InputAssemblies Include="$(OutputPath)DownloadAssistant.dll" />
			<InputAssemblies Include="$(OutputPath)Requests.dll" />
			<InputAssemblies Include="$(OutputPath)FFMpegCore.dll" />
			<InputAssemblies Include="$(OutputPath)Instances.dll" />
			<InputAssemblies Include="$(OutputPath)SharpCompress.dll" />
			<InputAssemblies Include="$(OutputPath)FuzzySharp.dll" />
			<InputAssemblies Include="$(OutputPath)Microsoft.Extensions.Logging.Abstractions.dll" />
			<InputAssemblies Include="$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll" />
			<InputAssemblies Include="$(OutputPath)Acornima.dll" />
			<InputAssemblies Include="$(OutputPath)System.Text.Json.dll" />
			<InputAssemblies Include="$(OutputPath)Jint.dll" />
			<InputAssemblies Include="$(OutputPath)Sentry.dll" />
			<InputAssemblies Include="$(OutputPath)System.Diagnostics.DiagnosticSource.dll" />
			<InputAssemblies Include="$(OutputPath)YamlDotNet.dll" />
		</ItemGroup>

		<ILRepack
            Parallel="true"
            Internalize="true"
            InputAssemblies="@(InputAssemblies)"
            TargetKind="Dll"
            DebugInfo="true"
            LibraryPath="..\Submodules\Lidarr\_output\net8.0\;$(OutputPath)"
            OutputFile="$(OutputPath)$(AssemblyName).dll"
        />
	</Target>
</Project>